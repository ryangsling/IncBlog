# App
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Auth
JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (leave DATABASE_FILE for SQLite dev, set DATABASE_URL for PostgreSQL prod)
DATABASE_FILE=./incblog.db
DATABASE_URL=

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Email (dev uses SMTP, prod uses Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
RESEND_FROM=

# Cloudflare R2 (prod only, dev uses local filesystem)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
