# App
PORT=3000
NODE_ENV=development
# In production this MUST be the real public URL (https://...). src/config/site.js
# refuses to boot in production if BASE_URL is missing or points at localhost, so
# email links and the Google OAuth callback can never ship as localhost. See FLY.md.
BASE_URL=http://localhost:3000

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-48-byte-random-hex
SESSION_SECRET=replace-with-a-48-byte-random-hex
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (leave DATABASE_FILE for SQLite dev, set DATABASE_URL for PostgreSQL prod)
DATABASE_FILE=./incblog.db
DATABASE_URL=
# In prod with SQLite + a persistent volume, point DATABASE_FILE at the mounted volume
# (e.g. /data/incblog.db), NOT DATABASE_URL — see FLY.md.
SEED_DEMO_IN_PROD=

# AI (OpenRouter — free models available at https://openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Email (dev uses SMTP, prod uses Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
RESEND_FROM=

# Cloudflare R2 (prod only, dev uses local filesystem)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
