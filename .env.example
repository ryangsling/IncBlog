# App
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Auth
JWT_SECRET=45308fcac7e9bcb1744218a95fa04d65211ee80a814a93329ad7e78c381a9d88
SESSION_SECRET=your_session_secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (leave DATABASE_FILE for SQLite dev, set DATABASE_URL for PostgreSQL prod)
DATABASE_FILE=./incblog.db
DATABASE_URL=

# AI (OpenRouter — free models available at https://openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Email (dev uses SMTP, prod uses Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
RESEND_FROM=

# Cloudflare R2 (prod only, dev uses local filesystem)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
