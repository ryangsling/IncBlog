<%- include('../partials/blog-top') %>
<% if (locals.subscribed) { %><div class="notice">Check your email to confirm your subscription.</div><% } %>
<% if (settings.blogDescription) { %><p class="blog-description"><%= settings.blogDescription %></p><% } %>
<% if (locals.currentUser && currentUser.id !== user.id) { %>
<form method="POST" action="/blog/<%= user.username %>/<%= isFollowing ? 'unfollow' : 'follow' %>" style="margin-bottom: var(--spacing-16);">
  <button class="btn <%= isFollowing ? 'btn-ghost' : 'btn-primary' %> btn-sm" type="submit"><%= isFollowing ? 'Unfollow' : '+ Follow' %></button>
</form>
<% } %>
<div class="post-list">
  <% posts.forEach(function(p) { %>
  <article class="post-card">
    <% if (p.featuredDisplay) { %><a href="<%= urls.post(p.slug) %>"><%- include('../partials/featured-image', { image: p.featuredDisplay, title: p.title, hero: false }) %></a><% } %>
    <h2><a href="<%= urls.post(p.slug) %>"><%= p.title %></a></h2>
    <p class="meta">
      <%= new Date(p.publishAt || p.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
      · <%= p.readMinutes %> min read
      <% if (p.Category) { %> · <a href="<%= urls.archive('category', p.Category.slug) %>"><%= p.Category.name %></a><% } %>
    </p>
    <% if (p.excerpt) { %><p class="excerpt"><%= p.excerpt %></p><% } %>
  </article>
  <% }) %>
  <% if (!posts.length) { %><p class="empty">No posts yet. Check back soon!</p><% } %>
</div>
<%- include('../partials/pagination') %>
<%- include('../partials/blog-bottom') %>
