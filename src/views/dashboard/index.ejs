<%- include('../partials/dashboard-top') %>
<div class="page-head">
  <h1>Dashboard</h1>
  <a class="btn btn-primary" href="/dashboard/posts/new">+ New post</a>
</div>
<div class="stat-cards">
  <div class="card stat"><span class="stat-value"><%= stats.totalPosts %></span><span class="stat-label">Total posts</span></div>
  <div class="card stat"><span class="stat-value"><%= stats.totalViews %></span><span class="stat-label">Total views</span></div>
  <div class="card stat"><span class="stat-value"><%= stats.subscriberCount %></span><span class="stat-label">Subscribers</span></div>
</div>
<div class="card">
  <h2>Recent posts</h2>
  <% if (recentPosts.length) { %>
  <table>
    <thead><tr><th>Title</th><th>Status</th><th>Views</th><th>Updated</th></tr></thead>
    <tbody>
      <% recentPosts.forEach(function(p) { %>
      <tr>
        <td><a href="/dashboard/posts/<%= p.id %>/edit"><%= p.title %></a></td>
        <td><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
        <td><%= p.views %></td>
        <td><%= new Date(p.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
  <p class="empty">No posts yet. <a href="/dashboard/posts/new">Write your first post</a>.</p>
  <% } %>
</div>
<%- include('../partials/dashboard-bottom') %>
