<%- include('../partials/dashboard-top') %>
<div class="page-head">
  <h1><%= post ? 'Edit post' : 'New post' %></h1>
</div>
<form method="POST" action="<%= post ? '/dashboard/posts/' + post.id : '/dashboard/posts' %>" enctype="multipart/form-data" id="post-form" class="post-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="editor-col">
    <input type="text" name="title" id="title" class="title-input" placeholder="Post title" value="<%= post ? post.title : '' %>" required>
    <div class="ai-row">
      <button type="button" class="btn btn-ghost btn-sm ai-btn" id="ai-titles">Improve Title</button>
      <div id="title-suggestions" class="title-suggestions"></div>
    </div>
    <div class="editor-toolbar">
      <span class="word-count" id="word-count">0 words · 1 min read</span>
    </div>
    <input type="hidden" name="content" id="content" value="<%= post ? post.content : '' %>">
    <input type="hidden" name="format" id="format" value="<%= post ? post.format : 'html' %>">
    <div id="editor-pane" class="editor-pane">
      <div id="editor-host" class="editor-host"></div>
    </div>
    <div class="sel-toolbar" hidden>
      <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
      <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
      <button type="button" data-cmd="h1" title="Heading 1">H1</button>
      <button type="button" data-cmd="h2" title="Heading 2">H2</button>
    </div>
    <div class="insert-menu" hidden>
      <div class="img-row">
        <input type="text" data-img-url placeholder="Paste image link (jpg, png, svg…)" autocomplete="off">
        <button type="button" data-insert="image" title="Insert image">Add</button>
      </div>
      <button type="button" data-insert="divider">Divider</button>
      <button type="button" data-insert="h2">Heading</button>
      <button type="button" data-insert="h3">Subheading</button>
    </div>

    <div id="ai-error" class="notice notice-error" hidden></div>
    <label>Excerpt
      <div class="field-with-action">
        <textarea name="excerpt" id="excerpt" rows="3" placeholder="A short hook for your post..."><%= post ? post.excerpt : '' %></textarea>
        <button type="button" class="btn btn-ghost btn-sm ai-btn" id="ai-excerpt">Generate Excerpt</button>
      </div>
    </label>
    <label>Summary
      <div class="field-with-action">
        <textarea name="summary" id="summary" rows="5" placeholder="A longer summary of your post..."><%= post ? post.summary : '' %></textarea>
        <button type="button" class="btn btn-ghost btn-sm ai-btn" id="ai-summary">Generate Summary</button>
      </div>
    </label>
  </div>
  <aside class="meta-col">
    <div class="card">
      <h3>Publish</h3>
      <label>Status
        <select name="status" id="status">
          <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
          <option value="scheduled" <%= post && post.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
        </select>
      </label>
      <label id="schedule-field" hidden>Publish at
        <input type="datetime-local" name="publishAt" value="<%= post && post.publishAt ? new Date(post.publishAt).toISOString().slice(0, 16) : '' %>">
      </label>
      <button class="btn btn-primary btn-block" type="submit">Save post</button>
    </div>
    <div class="card">
      <h3>Organize</h3>
      <label>Category
        <select name="categoryId">
          <option value="">— None —</option>
          <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= post && post.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Tags (comma-separated)
        <input type="text" name="tags" placeholder="tech, writing" value="<%= tagsString %>">
      </label>
    </div>
    <div class="card">
      <h3>Featured image</h3>
      <% if (post && post.featuredImage) { %><img class="image-preview" src="<%= post.featuredImage %>" alt="Featured image"><% } %>
      <input type="file" name="featuredImage" accept="image/jpeg,image/png,image/gif,image/webp">
    </div>
    <div class="card">
      <h3>SEO</h3>
      <label>Meta title
        <input type="text" name="metaTitle" value="<%= post ? post.metaTitle : '' %>">
      </label>
      <label>Meta description
        <textarea name="metaDescription" rows="3"><%= post ? post.metaDescription : '' %></textarea>
      </label>
      <label>OG image
        <% if (post && post.ogImage) { %><img class="image-preview" src="<%= post.ogImage %>" alt="OG image"><% } %>
        <input type="file" name="ogImage" accept="image/jpeg,image/png,image/gif,image/webp">
      </label>
    </div>
  </aside>
</form>
<script src="/js/editor.js"></script>
<%- include('../partials/dashboard-bottom') %>
