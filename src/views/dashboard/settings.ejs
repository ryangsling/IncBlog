<%- include('../partials/dashboard-top') %>
<div class="page-head">
  <h1>Settings</h1>
</div>
<% if (saved) { %><div class="notice">Settings saved.</div><% } %>
<% if (error) { %><div class="notice notice-error"><%= error %></div><% } %>
<form method="POST" action="/dashboard/settings">
  <div class="card">
    <h2>Blog</h2>
    <label>Blog title
      <input type="text" name="blogTitle" value="<%= settings.blogTitle %>">
    </label>
    <label>Description
      <textarea name="blogDescription" rows="3"><%= settings.blogDescription %></textarea>
    </label>
    <label>Footer text
      <input type="text" name="footerText" value="<%= settings.footerText %>">
    </label>
  </div>
  <div class="card">
    <h2>Social links</h2>
    <label>Twitter/X URL
      <input type="url" name="twitter" value="<%= settings.twitter %>" placeholder="https://x.com/you">
    </label>
    <label>GitHub URL
      <input type="url" name="github" value="<%= settings.github %>" placeholder="https://github.com/you">
    </label>
    <label>LinkedIn URL
      <input type="url" name="linkedin" value="<%= settings.linkedin %>" placeholder="https://linkedin.com/in/you">
    </label>
  </div>
  <div class="card">
    <h2>Integrations</h2>
    <label>Google Analytics ID
      <input type="text" name="gaId" value="<%= settings.gaId %>" placeholder="G-XXXXXXXXXX">
    </label>
  </div>
  <div class="card">
    <h2>Custom domain</h2>
    <label>Domain
      <input type="text" name="customDomain" value="<%= currentUser.customDomain || '' %>" placeholder="blog.yourdomain.com">
    </label>
    <% if (currentUser.customDomainVerifiedAt) { %>
    <label><input type="checkbox" name="customDomainCanonical" value="1" <%= currentUser.customDomainCanonical ? 'checked' : '' %>>
      Use this verified domain as the canonical address</label>
    <% } %>

  </div>
  <button class="btn btn-primary" type="submit">Save settings</button>
</form>
<% if (currentUser.customDomain) { %>
<div class="card">
  <h2>Domain verification</h2>
  <% if (domainStatus === 'dns') { %><p class="notice notice-error">The verification TXT record was not found.</p><% } %>
  <% if (domainStatus === 'claimed') { %><p class="notice notice-error">This domain is already verified for another blog.</p><% } %>
  <% if (domainStatus === 'missing') { %><p class="notice notice-error">Save the domain and try again.</p><% } %>
  <% if (currentUser.customDomainVerifiedAt) { %>
    <p>Verified. <%= currentUser.customDomainCanonical ? 'This is the canonical address.' : 'The platform blog URL is canonical.' %></p>
  <% } else if (currentUser.customDomainChallenge) { %>
    <p>Add a DNS TXT record at <code>_incblog-verification.<%= currentUser.customDomain %></code>
      with value <code>incblog=<%= currentUser.customDomainChallenge %></code>.</p>
    <p>Point the domain at the platform and have your hosting provider provision HTTPS before choosing it as canonical.</p>
    <form method="POST" action="/dashboard/settings/domain/verify">
      <label><input type="checkbox" name="canonical" value="1"> Use this domain as canonical after verification</label>
      <button class="btn" type="submit">Verify DNS ownership</button>
    </form>
  <% } else { %>
    <p>Save settings to generate a DNS verification record for this domain.</p>
  <% } %>
</div>
<% } %>
<div class="card">
  <h2>Export data</h2>
  <p>Download a full export of your posts, subscribers and settings as a JSON file.</p>
  <a class="btn" href="/dashboard/settings/export">Export data</a>
</div>
<div class="card danger-zone">
  <h2>Danger zone</h2>
  <p>Deleting your account permanently removes your posts, media, subscribers and settings. This cannot be undone.</p>
  <% if (reauth === 'sent') { %><p>Check your email for a one-time code.</p><% } %>
  <% if (reauth === 'ready') { %><p>Identity confirmed for 10 minutes.</p><% } %>
  <% if (!currentUser.passwordHash && currentUser.googleId && currentUser.emailVerified) { %>
  <form method="POST" action="/dashboard/settings/reauth/email">
    <button class="btn btn-ghost" type="submit">Send a one-time code</button>
  </form>
  <% } %>
  <% if (currentUser.passwordHash || (currentUser.googleId && currentUser.emailVerified)) { %>
  <form method="POST" action="/dashboard/settings/reauth">
    <% if (currentUser.passwordHash) { %>
    <label>Confirm your password <input type="password" name="password" autocomplete="current-password" required></label>
    <% } else { %>
    <label>One-time code <input type="text" name="code" autocomplete="one-time-code" maxlength="32" required></label>
    <% } %>
    <button class="btn btn-ghost" type="submit">Confirm identity</button>
  </form>
  <% } else { %>
  <p>Verify your email first to confirm your identity.</p>
  <% } %>
  <form method="POST" action="/dashboard/settings/delete-account" data-confirm="Permanently delete your account and all data?">
    <label>Type <strong>DELETE</strong> to confirm
      <input type="text" name="confirm" placeholder="DELETE" required>
    </label>
    <button class="btn btn-danger" type="submit">Delete account</button>
  </form>
</div>
<%- include('../partials/dashboard-bottom') %>
