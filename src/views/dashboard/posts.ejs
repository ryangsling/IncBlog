<%- include('../partials/dashboard-top') %>
<div class="page-head">
  <h1>Posts</h1>
  <a class="btn btn-primary" href="/dashboard/posts/new">+ New post</a>
</div>
<div class="tabs">
  <a href="/dashboard/posts" class="<%= statusFilter === 'all' ? 'active' : '' %>">All</a>
  <a href="/dashboard/posts?status=published" class="<%= statusFilter === 'published' ? 'active' : '' %>">Published</a>
  <a href="/dashboard/posts?status=draft" class="<%= statusFilter === 'draft' ? 'active' : '' %>">Draft</a>
  <a href="/dashboard/posts?status=scheduled" class="<%= statusFilter === 'scheduled' ? 'active' : '' %>">Scheduled</a>
</div>
<div class="card">
  <% if (posts.length) { %>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Title</th><th>Status</th><th>Category</th><th>Views</th><th>Date</th><th>Actions</th></tr></thead>
      <tbody>
        <% posts.forEach(function(p) { %>
        <tr>
          <td><a href="/dashboard/posts/<%= p.id %>/edit"><%= p.title %></a></td>
          <td><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
          <td><%= p.Category ? p.Category.name : '—' %></td>
          <td><%= p.views %></td>
          <td><%= new Date(p.publishAt || p.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
          <td class="actions">
            <a class="btn btn-ghost btn-sm" href="/dashboard/posts/<%= p.id %>/edit">Edit</a>
            <a class="btn btn-ghost btn-sm" href="/blog/<%= currentUser.username %>/<%= p.slug %>" target="_blank">View</a>
            <form method="POST" action="/dashboard/posts/<%= p.id %>/delete" data-confirm="Delete this post?" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-danger btn-sm" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="empty">No posts found for this filter.</p>
  <% } %>
</div>
<%- include('../partials/dashboard-bottom') %>
