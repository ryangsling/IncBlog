<!DOCTYPE html>
<html lang="en">
<head>
<%- include('head') %>
<title><%= title %></title>
<% if (locals.metaDescription) { %><meta name="description" content="<%= metaDescription %>"><% } %>
<% if (locals.ogTitle) { %>
<meta property="og:title" content="<%= ogTitle %>">
<meta name="twitter:title" content="<%= ogTitle %>">
<% } %>
<% if (locals.metaDescription) { %>
<meta property="og:description" content="<%= metaDescription %>">
<meta name="twitter:description" content="<%= metaDescription %>">
<% } %>
<% if (locals.ogImage) { %>
<meta property="og:image" content="<%= ogImage %>">
<meta name="twitter:image" content="<%= ogImage %>">
<% } %>
<meta property="og:type" content="article">
<meta name="twitter:card" content="summary_large_image">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/blog/<%= user.username %>/rss.xml">
<% if (settings.gaId) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.gaId %>"></script>
<script nonce="<%= cspNonce %>">window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','<%= settings.gaId %>');</script>
<% } %>
</head>
<body class="blog">
<header class="blog-header">
  <div class="container">
    <a class="logo" href="/blog/<%= user.username %>"><%= settings.blogTitle || (user.name + "'s Blog") %></a>
    <div>
      <a class="btn btn-ghost btn-sm" href="/explore">Explore</a>
      <a class="btn btn-ghost btn-sm" href="/blog/<%= user.username %>/rss.xml">RSS</a>
    </div>
  </div>
</header>
<main class="container blog-main">
